{
  "expo": {
    "name": "BYTE TALKS",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bytetalks",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0607",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.meetbypersonality.n45jnb",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add photos to your dating profile",
        "NSCameraUsageDescription": "Take profile photos and scan device link codes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0607"
      },
      "package": "com.emergent.meetbypersonality.n45jnb",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0607"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Add photos to your dating profile",
          "cameraPermission": "Take a new photo for your profile",
          "microphonePermission": false
        }
      ],
      "@react-native-vector-icons/ionicons",
      [
        "expo-camera",
        {
          "cameraPermission": "Take profile photos and scan device link codes",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
